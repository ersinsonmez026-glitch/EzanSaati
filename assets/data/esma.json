[{"ar":"اللَّهُ","ok":"Allah","an":"Yüce yaratıcının özel ismi; ibadete lâyık tek ilâh."},{"ar":"الرَّحْمَنُ","ok":"er-Rahmân","an":"Sonsuz merhametiyle bütün varlıklara lutuf ve ihsanda bulunan."},{"ar":"الرَّحِيمُ","ok":"er-Rahîm","an":"Çok merhametli; rahmeti sürekli olan."},{"ar":"الْمَلِكُ","ok":"el-Melik","an":"Mülkün ve bütün varlıkların gerçek sahibi ve hükümdarı."},{"ar":"الْقُدُّوسُ","ok":"el-Kuddûs","an":"Her türlü eksiklik ve kusurdan uzak, tertemiz."},{"ar":"السَّلاَمُ","ok":"es-Selâm","an":"Her türlü kusurdan uzak olan, esenlik veren."},{"ar":"الْمُؤْمِنُ","ok":"el-Mü'min","an":"Güven veren, kullarını korku ve endişeden emin kılan."},{"ar":"الْمُهَيْمِنُ","ok":"el-Müheymin","an":"Kâinatın bütün işlerini gözetip idare eden."},{"ar":"الْعَزِيزُ","ok":"el-Azîz","an":"İzzet sahibi, mağlup edilmesi imkânsız olan."},{"ar":"الْجَبَّارُ","ok":"el-Cebbâr","an":"Dilediğini yaptırmaya gücü yeten, eksikleri tamamlayan."},{"ar":"الْمُتَكَبِّرُ","ok":"el-Mütekebbir","an":"Büyüklükte eşi benzeri olmayan, ulu."},{"ar":"الْخَالِقُ","ok":"el-Hâlık","an":"Yaratan; varlıkları yoktan var eden."},{"ar":"الْبَارِئُ","ok":"el-Bâri'","an":"Varlıkları birbirine uygun ve kusursuz yaratan."},{"ar":"الْمُصَوِّرُ","ok":"el-Musavvir","an":"Varlıklara şekil ve özellik veren."},{"ar":"الْغَفَّارُ","ok":"el-Gaffâr","an":"Günahları çokça bağışlayan."},{"ar":"الْقَهَّارُ","ok":"el-Kahhâr","an":"Her şeye galip gelen, yegâne kudret ve tasarruf sahibi."},{"ar":"الْوَهَّابُ","ok":"el-Vehhâb","an":"Karşılık beklemeden bol bol veren."},{"ar":"الرَّزَّاقُ","ok":"er-Rezzâk","an":"Bedenlerin ve ruhların gıdasını yaratıp veren."},{"ar":"الْفَتَّاحُ","ok":"el-Fettâh","an":"Hayır kapılarını açan, kulları arasında hükmeden."},{"ar":"الْعَلِيمُ","ok":"el-Alîm","an":"Her şeyi hakkıyla bilen."},{"ar":"الْقَابِضُ","ok":"el-Kâbız","an":"Dilediğine rızkı daraltan, canlıların ruhunu alan."},{"ar":"الْبَاسِطُ","ok":"el-Bâsıt","an":"Dilediğine rızkı genişleten."},{"ar":"الْخَافِضُ","ok":"el-Hâfıd","an":"Dilediğini alçaltan."},{"ar":"الرَّافِعُ","ok":"er-Râfi'","an":"Dilediğini yükselten, izzetli ve şerefli kılan."},{"ar":"الْمُعِزُّ","ok":"el-Muiz","an":"Dilediğine izzet ve şeref veren."},{"ar":"الْمُذِلُّ","ok":"el-Müzil","an":"Dilediğini zillete düşüren."},{"ar":"السَّمِيعُ","ok":"es-Semî'","an":"Her şeyi hakkıyla işiten."},{"ar":"الْبَصِيرُ","ok":"el-Basîr","an":"Her şeyi hakkıyla gören."},{"ar":"الْحَكَمُ","ok":"el-Hakem","an":"Hükmeden, hak ile bâtılı ayıran."},{"ar":"الْعَدْلُ","ok":"el-Adl","an":"Mutlak adalet sahibi."},{"ar":"اللَّطِيفُ","ok":"el-Latîf","an":"Kullarına lutufla, yumuşaklıkla muamele eden; en ince şeyleri bilen."},{"ar":"الْخَبِيرُ","ok":"el-Habîr","an":"Her şeyin iç yüzünden haberdar olan."},{"ar":"الْحَلِيمُ","ok":"el-Halîm","an":"Cezalandırmakta acele etmeyen, yumuşak davranan."},{"ar":"الْعَظِيمُ","ok":"el-Azîm","an":"Pek büyük, azamet sahibi."},{"ar":"الْغَفُورُ","ok":"el-Gafûr","an":"Günahları bağışlayan."},{"ar":"الشَّكُورُ","ok":"eş-Şekûr","an":"Az bir iyiliğe bile fazlasıyla karşılık veren."},{"ar":"الْعَلِيُّ","ok":"el-Aliyy","an":"Pek yüce."},{"ar":"الْكَبِيرُ","ok":"el-Kebîr","an":"Pek büyük."},{"ar":"الْحَفِيظُ","ok":"el-Hafîz","an":"Her şeyi koruyup gözeten."},{"ar":"الْمُقِيتُ","ok":"el-Mukît","an":"Bedenlerin ve ruhların gıdasını veren, gücü yetip koruyan."},{"ar":"الْحَسِيبُ","ok":"el-Hasîb","an":"Her şeyi sayıp bilen, kullarını hesaba çeken."},{"ar":"الْجَلِيلُ","ok":"el-Celîl","an":"Celâl ve azamet sahibi."},{"ar":"الْكَرِيمُ","ok":"el-Kerîm","an":"Pek cömert, ikramı bol olan."},{"ar":"الرَّقِيبُ","ok":"er-Rakîb","an":"Her şeyi gözetip kontrol eden."},{"ar":"الْمُجِيبُ","ok":"el-Mucîb","an":"Dua ve dileklere karşılık veren."},{"ar":"الْوَاسِعُ","ok":"el-Vâsi'","an":"Rahmeti, ilmi ve kudreti her şeyi kuşatan."},{"ar":"الْحَكِيمُ","ok":"el-Hakîm","an":"Her işi ve hükmü hikmetli olan."},{"ar":"الْوَدُودُ","ok":"el-Vedûd","an":"Sâlih kullarını çok seven ve onlar tarafından çok sevilen."},{"ar":"الْمَجِيدُ","ok":"el-Mecîd","an":"Şanı yüce, şerefi ve cömertliği sonsuz olan."},{"ar":"الْبَاعِثُ","ok":"el-Bâis","an":"Ölüleri dirilten."},{"ar":"الشَّهِيدُ","ok":"eş-Şehîd","an":"Her şeye şahit olan."},{"ar":"الْحَقُّ","ok":"el-Hak","an":"Varlığı gerçek ve değişmez olan."},{"ar":"الْوَكِيلُ","ok":"el-Vekîl","an":"Kendisine güvenilip dayanılan, işleri üstlenen."},{"ar":"الْقَوِيُّ","ok":"el-Kaviyy","an":"Her şeye gücü yeten, kudret sahibi."},{"ar":"الْمَتِينُ","ok":"el-Metîn","an":"Kuvveti sarsılmaz, pek sağlam."},{"ar":"الْوَلِيُّ","ok":"el-Veliyy","an":"Müminlerin dostu ve yardımcısı."},{"ar":"الْحَمِيدُ","ok":"el-Hamîd","an":"Her türlü övgüye lâyık olan."},{"ar":"الْمُحْصِي","ok":"el-Muhsî","an":"Gizli açık her şeyi sayıp ayrıntısıyla bilen."},{"ar":"الْمُبْدِئُ","ok":"el-Mübdi'","an":"Örneği olmadan ilk defa yaratan."},{"ar":"الْمُعِيدُ","ok":"el-Muîd","an":"Yok ettiğini yeniden yaratan."},{"ar":"الْمُحْيِي","ok":"el-Muhyî","an":"Hayat veren, dirilten."},{"ar":"الْمُمِيتُ","ok":"el-Mümît","an":"Ölümü yaratan."},{"ar":"الْحَىُّ","ok":"el-Hayy","an":"Diri; ezelî ve ebedî hayat sahibi."},{"ar":"الْقَيُّومُ","ok":"el-Kayyûm","an":"Her şeyin varlığı kendisine bağlı olan, her şeyi ayakta tutan."},{"ar":"الْوَاجِدُ","ok":"el-Vâcid","an":"Dilediğini dilediği zaman bulan, hiçbir şeye muhtaç olmayan."},{"ar":"الْمَاجِدُ","ok":"el-Mâcid","an":"Şanı yüce, cömertliği bol olan."},{"ar":"الْوَاحِدُ","ok":"el-Vâhid","an":"Zâtında, sıfatlarında ve fiillerinde tek olan."},{"ar":"الصَّمَدُ","ok":"es-Samed","an":"Her şeyin kendisine muhtaç olduğu, kendisi hiçbir şeye muhtaç olmayan."},{"ar":"الْقَادِرُ","ok":"el-Kâdir","an":"Her şeye gücü yeten."},{"ar":"الْمُقْتَدِرُ","ok":"el-Muktedir","an":"Kudretini dilediği gibi kullanan."},{"ar":"الْمُقَدِّمُ","ok":"el-Mukaddim","an":"Dilediğini öne alan."},{"ar":"الْمُؤَخِّرُ","ok":"el-Muahhir","an":"Dilediğini geriye bırakan."},{"ar":"الأَوَّلُ","ok":"el-Evvel","an":"Varlığının başlangıcı olmayan."},{"ar":"الآخِرُ","ok":"el-Âhir","an":"Varlığının sonu olmayan."},{"ar":"الظَّاهِرُ","ok":"ez-Zâhir","an":"Varlığı delilleriyle apaçık olan."},{"ar":"الْبَاطِنُ","ok":"el-Bâtın","an":"Zâtının mahiyeti akıllarca kavranamayan."},{"ar":"الْوَالِي","ok":"el-Vâlî","an":"Bütün varlıkları yöneten."},{"ar":"الْمُتَعَالِي","ok":"el-Müteâlî","an":"İzzet, şeref ve hükümranlıkta yüceler yücesi."},{"ar":"الْبَرُّ","ok":"el-Berr","an":"İyiliği ve ihsanı bol olan."},{"ar":"التَّوَّابُ","ok":"et-Tevvâb","an":"Tövbeleri çokça kabul eden."},{"ar":"الْمُنْتَقِمُ","ok":"el-Müntekim","an":"Suçluları hak ettikleri cezaya çarptıran."},{"ar":"الْعَفُوُّ","ok":"el-Afüvv","an":"Günahları silen, affeden."},{"ar":"الرَّءُوفُ","ok":"er-Raûf","an":"Pek şefkatli."},{"ar":"مَالِكُ الْمُلْكِ","ok":"Mâlikü'l-mülk","an":"Mülkün ebedî sahibi."},{"ar":"ذُو الْجَلاَلِ وَالإِكْرَامِ","ok":"Zü'l-celâli ve'l-ikrâm","an":"Azamet ve ikram sahibi."},{"ar":"الْمُقْسِطُ","ok":"el-Muksit","an":"Adaletle hükmeden."},{"ar":"الْجَامِعُ","ok":"el-Câmi'","an":"Dilediğini bir araya toplayan."},{"ar":"الْغَنِيُّ","ok":"el-Ganiyy","an":"Hiçbir şeye muhtaç olmayan."},{"ar":"الْمُغْنِي","ok":"el-Muğnî","an":"Dilediğini zengin kılan."},{"ar":"الْمَانِعُ","ok":"el-Mâni'","an":"Dilemediği şeye engel olan."},{"ar":"الضَّارُّ","ok":"ed-Dârr","an":"Elem ve zarar veren şeyleri de yaratan."},{"ar":"النَّافِعُ","ok":"en-Nâfi'","an":"Fayda veren şeyleri yaratan."},{"ar":"النُّورُ","ok":"en-Nûr","an":"Âlemleri nurlandıran."},{"ar":"الْهَادِي","ok":"el-Hâdî","an":"Doğru yolu gösteren, hidayete erdiren."},{"ar":"الْبَدِيعُ","ok":"el-Bedî'","an":"Eşi ve örneği olmayan varlıklar yaratan."},{"ar":"الْبَاقِي","ok":"el-Bâkî","an":"Varlığı ebedî olan."},{"ar":"الْوَارِثُ","ok":"el-Vâris","an":"Her şey yok olduktan sonra kalan, gerçek mirasçı."},{"ar":"الرَّشِيدُ","ok":"er-Reşîd","an":"Her işi yerinde ve doğru olan."},{"ar":"الصَّبُورُ","ok":"es-Sabûr","an":"Çok sabırlı; cezalandırmakta acele etmeyen."}]